# ── Supabase ────────────────────────────────────────────────────────────────────
# Public URL of your Supabase project (safe to expose in frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon / public key for the Supabase JS client (frontend)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — NEVER expose this in the frontend bundle.
# Used only by server.js to bypass RLS for admin operations.
VITE_SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Server ───────────────────────────────────────────────────────────────────────
# Secret used to sign HMAC launch tokens (anti-replay protection).
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# ── Vercel Cron (optional) ───────────────────────────────────────────────────────
# Protects the /proxy/__cron cleanup endpoint.
# Set this to any random string and put the same value in vercel.json cron URL.
# Generate with: openssl rand -hex 16
CRON_SECRET=replace-with-another-random-string
